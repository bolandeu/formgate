# Formgate Pro configuration. Copy to .env and set the values. No real secret belongs in git.

# Read by Pro (pro/src/Config/defaults.php). FORMGATE_DATA_DIR and FORMGATE_PROJECTS_DIR are not set here:
# compose.yaml sets them next to the volume mounts.
# How long a request waits for another process that writes the SQLite database.
FORMGATE_SQLITE_BUSY_TIMEOUT_SECONDS=10
# GET /health fails when the last worker heartbeat is older than this.
FORMGATE_WORKER_HEARTBEAT_MAX_AGE_SECONDS=120
# The pause of the worker loop between two runs over the due queued requests.
FORMGATE_WORKER_PAUSE_SECONDS=5
# The pauses of the repeat schedule, in seconds, comma separated.
FORMGATE_REPEAT_SCHEDULE_SECONDS=60,300,900,3600,10800,43200,86400
# A channel is down after this many failures in a row, on any requests of its project.
FORMGATE_CHANNEL_DOWN_AFTER_FAILURES=3
# Requests and spam log entries older than this many days are deleted by the worker.
FORMGATE_RETENTION_DAYS=30
# The worker deletes the old entries at most once in this many seconds.
FORMGATE_RETENTION_INTERVAL_SECONDS=3600
# 1 turns off the private-address guard of the webhook channels (docs/pro-setup.md, section 4): a receiver on this
# server or on a private network is allowed. 0 (the default): a receiver host must resolve to public addresses only.
FORMGATE_WEBHOOK_ALLOW_PRIVATE=0
# The operator alert bot (one Telegram bot for all of Pro). Without a token the alerts are only logged.
FORMGATE_ALERT_BOT_TOKEN=
FORMGATE_ALERT_CHAT_ID=
# The Telegram Bot API host of the alert bot and its timeout.
FORMGATE_ALERT_API_URL=https://api.telegram.org
FORMGATE_ALERT_TIMEOUT_SECONDS=10

# The secret that signs the time tokens of all projects (docs/pro-setup.md, section 7). install.sh fills it with a
# random value; a changed secret makes the tokens already given invalid.
FORMGATE_TOKEN_SECRET=

# The keys of the admin API (docs/pro-setup.md, section 8), comma separated; two keys are valid at once during a
# rotation. Empty turns the admin API off. install.sh fills it with one random key on a new install.
FORMGATE_ADMIN_KEYS=

# Read by compose.yaml: the host address and port. Docker bypasses the host firewall, so the default is 127.0.0.1 only.
# For another address write it here, for example 0.0.0.0:8095.
FORMGATE_WEB_PORT=127.0.0.1:8095
# Read by compose.yaml: the host address and port of the admin API, a port next to FORMGATE_WEB_PORT. Keep it on
# 127.0.0.1 or a private network: the admin port has no TLS.
FORMGATE_ADMIN_PORT=127.0.0.1:8096
# Read by compose.yaml: the tag of the built image formgate-pro. Another Compose project on this Docker host
# uses another tag, so that its build does not replace this one.
# FORMGATE_IMAGE_TAG=latest

# HTTPS on a public server (docs/pro-tls.md): Caddy gets a Let's Encrypt certificate for this domain.
# The DNS record of the domain must point to this server, and ports 80 and 443 must be open.
# FORMGATE_DOMAIN=forms.example.com
# Turns on the tls profile. Without it web serves plain HTTP on FORMGATE_WEB_PORT.
# COMPOSE_PROFILES=tls

# Dev only: uncomment to mount the source (compose.dev.yaml).
# COMPOSE_FILE=compose.yaml:compose.dev.yaml
