{
  "name": "formgate",
  "version": "0.10.5",
  "license": "MIT",
  "description": "Form gateway: Lite PHP handler, client and Astro integration",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "prepack": "pnpm run build",
    "test": "vitest run"
  },
  "packageManager": "pnpm@12.9.1",
  "exports": {
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./astro": {
      "types": "./dist/astro/index.d.ts",
      "default": "./dist/astro/index.js"
    },
    "./lite/*": "./lite/*"
  },
  "files": [
    "dist",
    "lite"
  ],
  "peerDependencies": {
    "astro": ">=5"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "astro": "^7.3.8",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  }
}
